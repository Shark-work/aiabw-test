# Default provider for /api/chat (multi-step agent with tool calling)
# 阿里云百炼（通义千问）— OpenAI 兼容模式
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_MODEL=qwen-turbo

# Optional: Mistral (uncomment and set LLM_PROVIDER=mistral to use)
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-large-latest

# Optional: Google Gemini (uncomment and set LLM_PROVIDER=google to use)
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here
# GOOGLE_MODEL=gemini-2.5-flash-lite

# DeepSeek API for /api/recommend (AI Agent 智能诊断推荐)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# PostgreSQL database for persisting threads and messages
# Example: postgres://user:password@localhost:5432/aiabw
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aiabw

# XorPay (code-payment) for unlocking unlimited chat after the free tier
XORPAY_AID=your_xorpay_aid
XORPAY_SECRET=your_xorpay_secret
# Full public URL of the async notify endpoint, e.g. https://yourdomain.com/api/pay/notify
XORPAY_NOTIFY_URL=https://yourdomain.com/api/pay/notify
# Pay type: native = WeChat scan QR, alipay = Alipay face-to-face QR
XORPAY_PAY_TYPE=native
XORPAY_PRODUCT_NAME=Unlock Unlimited Pet Slots

# JWT auth secret for /api/auth/* (use a long random value in production)
AUTH_SECRET=your_long_random_auth_secret

# Long-term memory: run extraction every N messages; optional small extraction model
MEMORY_EXTRACT_EVERY=3
MEMORY_EXTRACT_MODEL=qwen-turbo

# Vercel Cron secret (guards /api/cron/* endpoints)
CRON_SECRET=your_long_random_cron_secret
