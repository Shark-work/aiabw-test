# ════════════════════════════════════════════════════════════════════════
# 艾比世界（AIBI 平台）· Vercel 生产环境变量模板
# 用法：Vercel Dashboard → Project → Settings → Environment Variables
#       按下表逐项添加（Environment 勾选 Production；预览环境按需勾选 Preview）。
#       本文件仅作模板，不含真实值，可安全提交仓库；真实值绝不写入仓库。
#
# ⚠️ 密钥前缀确认（安全红线）：
#   DATABASE_URL / JWT_SECRET(实际变量名 AUTH_SECRET) / CHAIN_DEPLOYER_KEY
#   三者均为【服务端专用】，【不带 NEXT_PUBLIC_ 前缀】——带该前缀的变量会被
#   内联进浏览器 bundle，任何人可见，数据库口令与链上私钥一旦泄露即事故。
#   全表仅 NEXT_PUBLIC_APP_URL（与 NEXT_PUBLIC_SITE_URL）允许暴露到前端。
# ════════════════════════════════════════════════════════════════════════

# ── 1) 数据库（必需 · 服务端专用 · 无 NEXT_PUBLIC_ 前缀）────────────────
# Neon Serverless Postgres 连接串，务必使用带 -pooler 的主机名（连接池模式）。
# 格式：postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# ── 2) JWT 签名密钥（必需 · 服务端专用 · 无 NEXT_PUBLIC_ 前缀）──────────
# 需求清单中的 JWT_SECRET 对应本变量 AUTH_SECRET —— 代码实际读取的名字是
# AUTH_SECRET（src/lib/auth.ts，jose HS256 签发/校验登录令牌）。
# ⚠️ 必须配置为足够随机的长字符串（≥32 字节）；不配置将回退到开发默认值
#    "dev-insecure-change-me"，生产环境绝对禁止。
# 生成示例：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=your_long_random_auth_secret_at_least_32_bytes

# ── 3) 链层（mock 默认；切真实链时配置）────────────────────────────────
# 缺省 = 链下模拟账本（CHAIN_DEPLOY_MODE=mock 语义），无需 RPC/私钥即可上线。
# CHAIN_PROVIDER=evm 时 CHAIN_RPC_URL / CHAIN_DEPLOYER_KEY / CHAIN_CONTRACT_ADDRESS
# 三项必填，缺一自动回退 mock（业务不中断）。详见 contracts/README.md。
CHAIN_PROVIDER=mock
# EVM RPC 端点（Alchemy/Infura/公共节点），仅 evm 模式需要（服务端专用）
CHAIN_RPC_URL=
# 部署者/MINTER_ROLE 热钱包私钥（0x+64hex）。
# ⚠️ 服务端专用 · 无 NEXT_PUBLIC_ 前缀 · 绝不写入仓库/前端/日志（服务端专用）
CHAIN_DEPLOYER_KEY=

# ── 4) 艾比销毁守卫（可选开关；缺省/0 = 关闭，API 契约与行为完全不变）────
# 需求清单中的 AIBI_BURN_GUARD 为「销毁守卫」的总称；代码不读取该名称，
# 实际由下列两个独立子开关组成（src/lib/aibi-service.ts BURN_GUARD）：
#   - 冷静期：同一用户两次主动销毁(user_burn)的最小间隔（小时），
#     开启后冷却期内销毁返回 429 BURN_COOLDOWN；
#   - 积分返还：每次主动销毁固定返还积分（与销毁同一事务入账，
#     流水 reason=aibi_burn_refund），开启后销毁响应附 refundedPoints。
# 仅作用于玩家主动销毁；融合消耗/管理员销毁不受影响。
# 上线初期建议保持 0（关闭），数值待产品决策后再开（见 roadmap backlog）。
AIBI_BURN_COOLDOWN_HOURS=0
AIBI_BURN_REFUND_POINTS=0

# ── 5) 站点公开 URL（必需 · 本表唯一允许 NEXT_PUBLIC_ 前缀的变量）───────
# 需求清单中的 NEXT_PUBLIC_APP_URL —— 前端可见的应用完整地址。
# 注意：当前代码实际读取的是 NEXT_PUBLIC_SITE_URL（src/lib/site.ts，用于
# sitemap/OG/canonical 等 SEO 输出）；NEXT_PUBLIC_APP_URL 为需求预留命名，
# 建议两者配置为同一值。
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ════════════════════════════════════════════════════════════════════════
# 以下为上线强烈建议/按功能需要配置（非本阶段清单项，供完整部署参考）
# ════════════════════════════════════════════════════════════════════════

# ── AI 对话（聊天/推荐依赖；OpenAI 兼容协议，按 OPENAI→DEEPSEEK→BAILIAN 回退）─
# 生产建议仅保留一个有效 key（参考 .clinerules ops-rules：失效 key 会造成静默回退）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── 运维（建议）─────────────────────────────────────────────────────────
# Neon 冷启动唤醒可能 >5s，缺省 15000ms，一般无需改
# DB_CONNECTION_TIMEOUT_MS=15000
# Vercel Cron 守护（/api/cron/*，如启用 Cron Jobs 则必填）
# CRON_SECRET=your_long_random_cron_secret

# ── 支付（码支付，按需；不配置则支付不可用，不影响聊天/艾比）────────────
# XORPAY_AID=...
# XORPAY_SECRET=...
# XORPAY_NOTIFY_URL=https://your-domain.com/api/pay/notify
# XORPAY_PAY_TYPE=native
# XORPAY_PRODUCT_NAME=Unlock Unlimited Pet Slots

# ── 6) Stripe 支付（Phase 11 · 艾比积分充值/卡包/道具；不配置则 503 优雅降级）──
# ⚠️ 五项全部【服务端专用】，绝不加 NEXT_PUBLIC_ 前缀（前缀会内联进浏览器 bundle）。
# STRIPE_SECRET_KEY     ：Dashboard → Developers → API keys → Secret key（sk_test_/sk_live_）
# STRIPE_WEBHOOK_SECRET ：Dashboard → Developers → Webhooks → 添加端点
#                         https://your-domain.com/api/stripe/webhook
#                         （监听 checkout.session.completed / checkout.session.expired）
#                         → 查看 Signing secret（whsec_…）
# STRIPE_PRICE_ID_*     ：Dashboard → Product catalog 建 3 个 Product（一次性 Price），
#                         各取 Price ID（price_…）
# 详细配置步骤 / 测试卡 4242 / Stripe CLI 冒烟验证：docs/stripe-integration.md
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_POINTS=price_xxx
STRIPE_PRICE_ID_PACK=price_xxx
STRIPE_PRICE_ID_ITEM=price_xxx
